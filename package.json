{
    "name": "@jpahd/kalendus",
    "version": "0.12.0",
    "description": "A sophisticated, responsive calendar web component built with Lit 3.x and TypeScript.",
    "keywords": [
        "calendar",
        "calendar-component",
        "lit",
        "lit-element",
        "typescript",
        "web-components"
    ],
    "homepage": "https://github.com/pders01/kalendus",
    "bugs": {
        "url": "https://github.com/pders01/kalendus/issues"
    },
    "license": "MIT",
    "author": "Paul Derscheid <paul.derscheid@lmscloud.de>",
    "repository": {
        "type": "git",
        "url": "https://github.com/pders01/kalendus.git"
    },
    "workspaces": [
        "server"
    ],
    "files": [
        "dist",
        "custom-elements.json"
    ],
    "type": "module",
    "sideEffects": true,
    "main": "./dist/kalendus.js",
    "module": "./dist/kalendus.js",
    "types": "./dist/lms-calendar.d.ts",
    "exports": {
        ".": {
            "types": "./dist/lms-calendar.d.ts",
            "import": "./dist/kalendus.js",
            "default": "./dist/kalendus.js"
        },
        "./entry-interactions": {
            "types": "./dist/entry-interactions.d.ts",
            "import": "./dist/entry-interactions.js"
        },
        "./themes/default.css": "./dist/themes/default.css",
        "./themes/ink.css": "./dist/themes/ink.css",
        "./themes/soft.css": "./dist/themes/soft.css",
        "./themes/brutalist.css": "./dist/themes/brutalist.css",
        "./themes/midnight.css": "./dist/themes/midnight.css",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vite build && npm run build:interactions && tsc --project tsconfig.build.json",
        "build:interactions": "vite build --config vite.config.interactions.ts",
        "build:iife": "vite build --config vite.config.iife.ts",
        "build:all": "npm run build && npm run build:iife",
        "build:watch": "vite build --watch",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit",
        "lint": "npm run lint:lit-analyzer && npm run lint:oxlint",
        "lint:oxlint": "oxlint src/",
        "lint:lit-analyzer": "lit-analyzer",
        "format": "npm run format:files -- --write",
        "format:check": "npm run format:files -- --check",
        "format:files": "oxfmt '{src,test,scripts,expo-bridge,server/{src,test,scripts},.storybook}/**/*.{ts,tsx,js,mjs,cjs}' 'server/*.{ts,js,json}' '*.config.{ts,js,mjs}' '.github/workflows/*.yml' 'vitest.shims.d.ts' 'README.md' '*.json'",
        "analyze": "cem analyze --litelement --globs \"src/**/*.ts\" --exclude \"src/**/*.stories.ts\" --exclude \"src/lib/debug/**\" && oxfmt --write custom-elements.json",
        "analyze:watch": "cem analyze --litelement --globs \"src/**/*.ts\" --exclude \"src/**/*.stories.ts\" --exclude \"src/lib/debug/**\" --watch",
        "checksize": "bun scripts/checksize.mjs",
        "test:package": "bun scripts/check-package.mjs",
        "prepublishOnly": "npm run clean && npm run test:release",
        "audit:production": "bun audit --prod --audit-level=low",
        "test:release": "export TEST_BROWSERS=${TEST_BROWSERS:-chromium,firefox,webkit}; npm run audit:production && npm run typecheck && npm run build:all && npm run analyze && npm run test && npm run test:components && npm run test-storybook && npm run test:e2e && npm run test:bridge && npm run test:bridge:inline && npm run lint && npm run format:check && npm run i18n:check && npm run docs:sync:check && npm run docs:build && bun run --cwd server typecheck && bun run --cwd server lint && bun run --cwd server test && bun run --cwd server test:browser && bun run --cwd server build && bun run --cwd server test:package && npm run test:package && npm run checksize",
        "check:bridge": "bun scripts/check-bridge.mjs",
        "test:bridge": "bun scripts/check-bridge.mjs --browser",
        "test:bridge:inline": "npm run build:iife && bun expo-bridge/build-shell.mjs --inline && BRIDGE_TEST_INLINE=1 npm run test:bridge",
        "test": "NODE_OPTIONS=--experimental-vm-modules mocha",
        "test:watch": "NODE_OPTIONS=--experimental-vm-modules mocha --watch",
        "test:components": "web-test-runner",
        "test:components:watch": "web-test-runner --watch",
        "test:components:coverage": "web-test-runner --coverage",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test-storybook": "vitest --project=storybook --run",
        "test:e2e": "playwright test",
        "i18n:extract": "lit-localize extract",
        "i18n:build": "lit-localize build",
        "i18n:check": "bun scripts/check-locales.mjs",
        "demo:gif": "node scripts/record-demo-gif.mjs",
        "docs:sync": "node scripts/sync-docs.mjs",
        "docs:sync:check": "node scripts/sync-docs.mjs --check",
        "docs:build": "node scripts/sync-docs.mjs && rimraf _site && eleventy && node scripts/check-docs-links.mjs",
        "docs:serve": "eleventy --serve"
    },
    "dependencies": {},
    "devDependencies": {
        "@11ty/eleventy": "^3.1.8",
        "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
        "@custom-elements-manifest/analyzer": "^0.11.0",
        "@lit/localize": "^0.12.2",
        "@lit/localize-tools": "^0.8.1",
        "@open-wc/testing": "^4.0.0",
        "@remcovaes/web-test-runner-vite-plugin": "^1.4.0",
        "@storybook/addon-docs": "10.6.7",
        "@storybook/addon-vitest": "10.6.7",
        "@storybook/web-components": "10.6.7",
        "@storybook/web-components-vite": "10.6.7",
        "@types/chai": "^5.2.3",
        "@types/luxon": "^3.7.1",
        "@types/mocha": "^10.0.10",
        "@vitest/browser-playwright": "^4.1.12",
        "@vitest/coverage-v8": "^4.1.12",
        "@web/dev-server": "^0.4.6",
        "@web/dev-server-esbuild": "^1.0.5",
        "@web/dev-server-legacy": "^2.1.1",
        "@web/rollup-plugin-html": "^3.1.0",
        "@web/test-runner": "^0.20.2",
        "@web/test-runner-playwright": "^0.11.1",
        "@webcomponents/webcomponentsjs": "^2.8.0",
        "chai": "^6.2.2",
        "github-slugger": "2.0.0",
        "lit": "^3.3.2",
        "lit-analyzer": "^2.0.3",
        "luxon": "^3.7.2",
        "magic-string": "0.30.21",
        "mocha": "^11.7.5",
        "oxfmt": "0.35.0",
        "oxlint": "1.50.0",
        "parse5": "7.3.0",
        "playwright": "^1.58.2",
        "remeda": "^2.33.6",
        "rimraf": "^6.1.3",
        "rolldown": "1.0.0-rc.6",
        "storybook": "10.6.7",
        "ts-ics": "^2.4.1",
        "ts-node": "^10.9.2",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "vite": "^7.3.8",
        "vite-plugin-static-copy": "^3.2.0",
        "vitest": "^4.1.12"
    },
    "peerDependencies": {
        "lit": "^3.0.0",
        "luxon": "^3.4.4"
    },
    "overrides": {
        "shell-quote": "^1.12.0",
        "tinypool": "^2.2.0"
    },
    "customElements": "custom-elements.json"
}

{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "trailingComma": "all",
    "tabWidth": 4,
    "singleQuote": true,
    "bracketSpacing": true,
    "arrowParens": "always",
    "sortImports": {},
    "ignorePatterns": [
        "dist/**",
        "server/dist/**",
        "storybook-static/**",
        "_site/**",
        "test-results/**",
        "playwright-report/**",
        "coverage/**"
    ]
}

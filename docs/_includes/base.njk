<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — Kalendus</title>
  <style>
    /* ── Reset & Base ────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --sidebar-w: 260px;
      --header-h: 56px;
      --clr-bg: #ffffff;
      --clr-surface: #f6f8fa;
      --clr-border: #d1d9e0;
      --clr-text: #1f2328;
      --clr-text-muted: #656d76;
      --clr-accent: #0969da;
      --clr-accent-subtle: #ddf4ff;
      --clr-code-bg: #f6f8fa;
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
      color-scheme: light dark;
      scroll-padding-block-start: calc(var(--header-h) + 0.75rem);
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --clr-bg: #0d1117;
        --clr-surface: #161b22;
        --clr-border: #30363d;
        --clr-text: #e6edf3;
        --clr-text-muted: #8b949e;
        --clr-accent: #58a6ff;
        --clr-accent-subtle: #0c2d6b;
        --clr-code-bg: #161b22;
      }
    }

    body {
      font-family: var(--font-sans);
      color: var(--clr-text);
      background: var(--clr-bg);
      line-height: 1.6;
    }

    /* ── Header ──────────────────────────────────── */
    .site-header {
      position: fixed; top: 0; left: 0; right: 0;
      z-index: 100;
      min-height: 56px;
      display: flex; flex-wrap: wrap; align-items: center; gap: 12px;
      padding: 0 20px;
      background: var(--clr-surface);
      border-bottom: 1px solid var(--clr-border);
    }
    .site-header a {
      color: var(--clr-text);
      text-decoration: none;
      font-weight: 600;
      font-size: 18px;
    }
    .site-header .gh-link {
      margin-left: auto;
      font-size: 14px;
      font-weight: 400;
      color: var(--clr-text-muted);
    }
    .site-header .gh-link:hover { color: var(--clr-accent); }

    /* ── Sidebar ─────────────────────────────────── */
    .sidebar {
      position: fixed; top: var(--header-h); bottom: 0; left: 0;
      width: var(--sidebar-w);
      overflow-y: auto;
      padding: 20px 16px;
      background: var(--clr-surface);
      border-right: 1px solid var(--clr-border);
      z-index: 90;
    }
    .sidebar nav a {
      display: block;
      padding: 6px 12px;
      margin: 2px 0;
      border-radius: 6px;
      color: var(--clr-text-muted);
      text-decoration: none;
      font-size: 14px;
      transition: background 0.15s, color 0.15s;
    }
    .sidebar nav a:hover {
      background: var(--clr-accent-subtle);
      color: var(--clr-accent);
    }
    .sidebar nav a.active {
      background: var(--clr-accent-subtle);
      color: var(--clr-accent);
      font-weight: 600;
    }
    .sidebar nav .nav-section {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--clr-text-muted);
      padding: 16px 12px 4px;
    }

    /* Native button disclosure; without JS navigation remains visible in flow. */
    [hidden] { display: none !important; }
    .nav-toggle {
      font: inherit;
      padding: 8px 12px;
      min-block-size: 44px;
      color: var(--clr-text);
      background: var(--clr-bg);
      border: 1px solid var(--clr-border);
      border-radius: 6px;
      cursor: pointer;
    }
    :where(a, button, .table-scroll, pre):focus-visible {
      outline: 3px solid var(--clr-accent);
      outline-offset: 2px;
    }

    @media (max-width: 768px) {
      .sidebar {
        position: static;
        width: auto;
        padding-top: calc(var(--header-h) + 20px);
      }
      .js-nav .sidebar {
        position: fixed;
        padding-top: 20px;
        width: min(100%, var(--sidebar-w));
        max-height: calc(100dvh - var(--header-h));
      }
    }

    /* ── Main content ────────────────────────────── */
    .main {
      margin-top: var(--header-h);
      padding: 40px 48px 80px;
      max-width: 880px;
      margin-right: auto;
      margin-left: max(var(--sidebar-w), calc(50% - 440px));
      overflow-wrap: anywhere;
    }
    @media (max-width: 768px) {
      .main { margin-left: 0; padding: 24px 16px 48px; }
    }

    /* ── Typography ──────────────────────────────── */
    .main h1 { font-size: 2em; margin: 0 0 16px; border-bottom: 1px solid var(--clr-border); padding-bottom: 8px; }
    .main h2 { font-size: 1.5em; margin: 32px 0 12px; border-bottom: 1px solid var(--clr-border); padding-bottom: 6px; }
    .main h3 { font-size: 1.25em; margin: 24px 0 8px; }
    .main h4 { font-size: 1em; margin: 20px 0 6px; }
    .main p { margin: 0 0 16px; }
    .main a { color: var(--clr-accent); text-underline-offset: 0.15em; }
    .main a:hover { text-decoration-thickness: 0.125em; }
    .main ul, .main ol { padding-left: 24px; margin: 0 0 16px; }
    .main li { margin: 4px 0; }
    .main img { max-width: 100%; border-radius: 8px; }
    .main blockquote {
      margin: 0 0 16px;
      padding: 8px 16px;
      border-left: 4px solid var(--clr-accent);
      color: var(--clr-text-muted);
      background: var(--clr-surface);
      border-radius: 0 6px 6px 0;
    }
    .main hr { border: none; border-top: 1px solid var(--clr-border); margin: 24px 0; }

    /* ── Tables ───────────────────────────────────── */
    .table-scroll { max-inline-size: 100%; overflow-x: auto; margin-block-end: 1rem; }
    .main table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.875rem;
      overflow-wrap: normal;
    }
    .main th, .main td {
      padding: 8px 12px;
      border: 1px solid var(--clr-border);
      text-align: left;
    }
    .main th { background: var(--clr-surface); font-weight: 600; }

    /* ── Inline code ─────────────────────────────── */
    .main code {
      font-family: var(--font-mono);
      font-size: 0.875em;
      background: var(--clr-code-bg);
      padding: 2px 6px;
      border-radius: 4px;
    }
    .main pre { margin: 0 0 16px; border-radius: 8px; overflow-x: auto; }
    .main pre code { background: none; padding: 0; font-size: inherit; }
    .main .docs-version { margin-block-end: 1.25rem; font-size: 0.875rem; color: var(--clr-text-muted); }

    /* ── Prism One Dark (for syntax highlight plugin) */
    pre[class*="language-"] {
      background: #282c34;
      color: #abb2bf;
      padding: 16px 20px;
      font-size: 0.875rem;
      line-height: 1.55;
      tab-size: 2;
    }
    .token.comment, .token.prolog, .token.doctype, .token.cdata { color: #a1aab9; font-style: italic; }
    .token.punctuation { color: #abb2bf; }
    .token.property, .token.tag, .token.boolean, .token.number, .token.constant, .token.symbol, .token.deleted { color: #f18c95; }
    .token.selector, .token.attr-name, .token.string, .token.char, .token.builtin, .token.inserted { color: #98c379; }
    .token.operator, .token.entity, .token.url, .language-css .token.string, .style .token.string { color: #56b6c2; }
    .token.atrule, .token.attr-value, .token.keyword { color: #d392e8; }
    .token.function, .token.class-name { color: #61afef; }
    .token.regex, .token.important, .token.variable { color: #d19a66; }
  </style>
</head>
<body>
  <header class="site-header">
    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="docs-sidebar" hidden>Navigation</button>
    <a href="{{ '/' | url }}">Kalendus</a>
    <a class="gh-link" href="https://github.com/pders01/kalendus">GitHub</a>
  </header>

  <aside class="sidebar" id="docs-sidebar">
    <nav aria-label="Documentation">
      {%- set currentSection = "" %}
      {%- for doc in collections.docs %}
        {%- if doc.data.section != currentSection %}
          {%- set currentSection = doc.data.section %}
          <div class="nav-section">{{ currentSection }}</div>
        {%- endif %}
        <a href="{{ doc.url | url }}" {% if doc.url == page.url %}class="active" aria-current="page"{% endif %}>
          {{ doc.data.title }}
        </a>
      {%- endfor %}
    </nav>
  </aside>

  <main class="main">
    <p class="docs-version">These guides follow the main branch and can describe unreleased features.
      See <a href="{{ '/docs/release-notes/' | url }}#0120">Release Notes</a> for the published 0.12.0 package.</p>
    {{ content | safe }}
  </main>
  <script>
    const toggle = document.querySelector('.nav-toggle');
    const sidebar = document.getElementById('docs-sidebar');
    const narrow = matchMedia('(max-width: 768px)');
    function setOpen(open) {
      if (!open && sidebar.contains(document.activeElement)) toggle.focus();
      sidebar.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    }
    function syncLayout() {
      if (narrow.matches) toggle.hidden = false;
      setOpen(!narrow.matches);
      if (!narrow.matches) {
        // Move focus before hiding the disclosure during a desktop transition.
        if (document.activeElement === toggle) sidebar.querySelector('a')?.focus();
        toggle.hidden = true;
      }
    }
    document.documentElement.classList.add('js-nav');
    toggle.addEventListener('click', () => setOpen(sidebar.hidden));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && narrow.matches && !sidebar.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
    narrow.addEventListener('change', syncLayout);
    syncLayout();
    // A wrapped/enlarged header must not cover the navigation or main content.
    new ResizeObserver(([entry]) => {
      document.documentElement.style.setProperty('--header-h', `${entry.target.getBoundingClientRect().height}px`);
    }).observe(document.querySelector('.site-header'));
  </script>
  <script>
    // Make wide content keyboard-scrollable without adding stops when it fits.
    const scrollers = document.querySelectorAll('main :is(.table-scroll, pre)');
    function syncScrollableRegion(target, keepFocus) {
      if (target.scrollWidth > target.clientWidth) {
        target.tabIndex = 0;
        target.setAttribute('role', 'region');
        target.setAttribute('aria-label', target.dataset.scrollLabel);
      } else if (!keepFocus) {
        for (const attr of ['tabindex', 'role', 'aria-label']) target.removeAttribute(attr);
      }
    }
    const scrollObserver = new ResizeObserver((entries) => {
      for (const { target } of entries) syncScrollableRegion(target, document.activeElement === target);
    });
    for (const scroller of scrollers) {
      scroller.dataset.scrollLabel = scroller.getAttribute('aria-label');
      scrollObserver.observe(scroller);
      // Retain focus through resize, then remove a tab stop that no longer scrolls.
      scroller.addEventListener('blur', () => syncScrollableRegion(scroller, false));
      // WebKit may send arrow scrolling to the page even when a region is focused.
      scroller.addEventListener('keydown', (event) => {
        if (event.target !== scroller || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey ||
            scroller.scrollWidth <= scroller.clientWidth) return;
        const direction = event.key === 'ArrowLeft' ? -1 : event.key === 'ArrowRight' ? 1 : 0;
        if (!direction) return;
        event.preventDefault();
        scroller.scrollBy({ left: direction * 40 });
      });
    }
  </script>
</body>
</html>
